# ===============================================================
#   ATRIUM — VARIÁVEIS DE AMBIENTE E SEGURANÇA
# ===============================================================

NODE_ENV=development
# NODE_ENV=production aplica automaticamente os controles cloud-only e exige
# segredos, origem frontend, token de setup e cookies seguros explícitos.
HOST=127.0.0.1
PORT=4173
COOKIE_SECURE=false

# Chaves de segurança. Na execução local, valores ausentes são gerados
# automaticamente e anexados ao arquivo .env sem sobrescrever os existentes.
# Para ambientes administrados, gere valores explícitos com:
# corepack pnpm setup:keys
AUTH_SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
COLLECTOR_INGEST_TOKEN=

# Obrigatório em cloud: protege a criação do primeiro administrador.
SETUP_BOOTSTRAP_TOKEN=
# Em cloud, habilite explicitamente para permitir autosserviço de novos escritórios.
# Se false ou vazio, somente contas existentes poderão entrar.
ATRIUM_PUBLIC_SIGNUP=false

# Origens exatas do frontend exposto, separadas por vírgula (deixe vazio para uso local).
# Exemplo: https://app.seu-dominio.adv.br
ATRIUM_FRONTEND_ORIGINS=

# Agenda Externa (Webcal / iCalendar) - Sincronização com Google Agenda, Outlook, Apple Calendar
EXTERNAL_CALENDAR_URL=

# Base pública do ATRIUM para links em e-mails transacionais (ex.: redefinição de senha).
# Usada com fragmento (#reset=...) para que o token nunca transite em logs de acesso.
ATRIUM_BASE_URL=https://atrium.seu-dominio.adv.br

# Coletores Judiciais Oficiais (Opcional - DJEN / DataJud / CNJ)
DJEN_API_ENABLED=true
DATAJUD_API_KEY=

# Stable DJEN inbox watermark (YYYY-MM-DD).
# Older communications may still be queried for discovery/audit,
# but are not bulk-added to the normal inbox.
ATRIUM_DJEN_TRACKING_SINCE=

# Diretório local dos dados cifrados. Vazio usa ./data na instalação.
JURISFLOW_DATA_DIR=

# OCR local opcional (Tesseract + pdftoppm instalados separadamente).
ATRIUM_TESSERACT_PATH=
ATRIUM_PDFTOPPM_PATH=
ATRIUM_OCR_LANGUAGES=por

# ---------------------------------------------------------------
# Judicial Intelligence BETA (experimental, isolado, read-only)
# Desativado por padrão. Nenhuma superfície é exposta a usuários.
# Habilitar apenas em ambiente local/sandbox para testes.
# ---------------------------------------------------------------
BETA_PDPJ_PROVIDER=false
BETA_DOCUMENT_ACQUISITION=false
BETA_PROCESS_INTELLIGENCE=false
BETA_DUE_DILIGENCE=false
BETA_PRIVACY_AUDIT=false
BETA_LEGAL_RAG=false
# Kill-switch de automação do beta (padrão true): subir o servidor NÃO autoriza
# varredura, download massivo, lote de certidões, polling ou monitoramento.
# Defina false apenas para uma execução local explicitamente supervisionada.
BETA_DISABLE_AUTOMATIONS=true
# Token PDPJ capturado manualmente pelo próprio usuário (efêmero; nunca persistido).
PDPJ_ACCESS_TOKEN=

# ATRIUM Mail & Notification Engine (Resend API / Webhooks)
# Obtenha sua chave no painel da Resend (https://resend.com)
RESEND_API_KEY=
# Endereço de suporte do escritório para o "Relato de erro" (opcional). Sem ele,
# o relato fica registrado no servidor e a tela declara que o suporte não está configurado.
ATRIUM_SUPPORT_EMAIL=
# Segredo do webhook gerado na Resend (inicia com whsec_)
RESEND_WEBHOOK_SECRET=
# Remetentes oficiais com domínio verificado na Resend
# Exemplo: publicacoes@suadominio.adv.br / notificacoes@seudominio.adv.br
ATRIUM_EMAIL_FROM_PUBLICATIONS=
ATRIUM_EMAIL_FROM_NOTIFICATIONS=
# Orçamento e limites de envio por escritório/instalação
EMAIL_DAILY_SEND_LIMIT=100
EMAIL_MONTHLY_SEND_LIMIT=3000
# Flag de preservação do SMTP legado (padrão: false). Mantenha false salvo em rollback.
ATRIUM_LEGACY_SMTP_ENABLED=false
# Domicílio Eletrônico (PDPJ/Jus.br) — captura no servidor.
# O portal recusa IPs de nuvem (403). Configure uma saída aceita para o ciclo
# deixar de declarar PORTAL_BLOCKED. Nunca versionar valores reais.
DOMICILIO_PROXY_URL=
DOMICILIO_PROXY_USERNAME=
DOMICILIO_PROXY_PASSWORD=
# Fallback de egress para portais quando o proxy específico do Domicílio não existe.
PORTAL_PROXY_URL=
PORTAL_PROXY_USERNAME=
PORTAL_PROXY_PASSWORD=
# Fábrica de Cálculos (TRF3/PDPJ) — somente leitura; sem chave a integração falha
# fechada com FABRICA_NOT_CONFIGURED.
FC_API_KEY=
# Modelo de decisão JEV / Provider API (exclusivamente server-side).
JEV_API_KEY=
CMD_API_KEY=

# Inteligência Jurídica do Gerador de Minutas (Legal MCP — discovery opcional)
# Desabilitado por padrão. Nenhuma consulta externa ocorre sem ATRIUM_LEGAL_MCP_ENABLED=true.
ATRIUM_LEGAL_MCP_ENABLED=false
# Base REST do provider de pesquisa jurídica (https://api.mcp.ai/api/legal).
ATRIUM_LEGAL_MCP_BASE_URL=https://api.mcp.ai/api/legal
# Chave opcional, exclusivamente server-side. Nunca informar no frontend.
ATRIUM_LEGAL_MCP_API_KEY=
ATRIUM_LEGAL_MCP_TIMEOUT_MS=20000
ATRIUM_LEGAL_MCP_MAX_RESULTS=10

# ===============================================================
#   ATRIUM — AMBIENTE E FLAGS EXPERIMENTAIS (MEGA BETA)
# ===============================================================
# Identificação server-side do ambiente. Ausente assume NODE_ENV e, por fim,
# production. Use ATRIUM_ENV=beta somente na instância beta isolada.
ATRIUM_ENV=

# Flags experimentais declaradas em lib/beta/feature-flags.mjs.
# Elas somente produzem efeito quando ATRIUM_ENV=beta; em qualquer outro
# ambiente o estado efetivo é sempre false (nenhuma rota, worker, UI ou
# chamada externa experimental). Confirme o estado real em GET /api/health.
ATRIUM_BETA_MODE=false
BETA_JUDICIAL_INTELLIGENCE=false
BETA_LEGAL_INTELLIGENCE=false
BETA_LEGAL_MCP=false
BETA_ROM_RECIPES=false
BETA_LEX_SKILLS=false
# BETA_LEGAL_RAG e BETA_DISABLE_AUTOMATIONS são compartilhadas com a camada
# Judicial Intelligence e têm valor único documentado no bloco
# "Judicial Intelligence BETA" acima (BETA_LEGAL_RAG=false e
# BETA_DISABLE_AUTOMATIONS=true, o kill-switch de automação).

# ===============================================================
#   GOOGLE AGENDA (sincronização nos dois sentidos, por pessoa)
# ===============================================================
# Sem estas duas chaves, o cartão de Integrações mostra "Em preparação" e nada roda.
#   Endereço de retorno a cadastrar no Google Cloud (na URL pública do seu ATRIUM):
#   https://app.seu-dominio.adv.br/api/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
