# ===============================================================
#   JURISFLOW — VARIÁVEIS DE AMBIENTE & SEGURANÇA
# ===============================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
COOKIE_SECURE=false

# Chaves de segurança (Gere novas chaves executando: npm run setup:keys)
AUTH_SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
COLLECTOR_INGEST_TOKEN=

# Agenda Externa (Webcal / iCalendar) - Sincronização com Google Agenda, Outlook, Apple Calendar
EXTERNAL_CALENDAR_URL=

# Coletores Judiciais Oficiais (Opcional - DJEN / DataJud / CNJ)
DJEN_API_ENABLED=true
DATAJUD_API_KEY=
