# ===============================================================
#   ATRIUM — VARIÁVEIS DE AMBIENTE E SEGURANÇA
# ===============================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
COOKIE_SECURE=false

# Chaves de segurança. Na execução local, valores ausentes são gerados
# automaticamente e anexados ao arquivo .env sem sobrescrever os existentes.
# Para ambientes administrados, gere valores explícitos com:
# corepack pnpm setup:keys
AUTH_SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
COLLECTOR_INGEST_TOKEN=

# Opcional em ambientes publicados: protege a criação do primeiro administrador.
SETUP_BOOTSTRAP_TOKEN=

# Agenda Externa (Webcal / iCalendar) - Sincronização com Google Agenda, Outlook, Apple Calendar
EXTERNAL_CALENDAR_URL=

# Coletores Judiciais Oficiais (Opcional - DJEN / DataJud / CNJ)
DJEN_API_ENABLED=true
DATAJUD_API_KEY=

# Diretório local dos dados cifrados. Vazio usa ./data na instalação.
JURISFLOW_DATA_DIR=

# OCR local opcional (Tesseract + pdftoppm instalados separadamente).
ATRIUM_TESSERACT_PATH=
ATRIUM_PDFTOPPM_PATH=
ATRIUM_OCR_LANGUAGES=por
