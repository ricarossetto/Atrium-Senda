+            tags: ['eproc', 'autos', 'tjrs', 'a1', 'peca-oficial'],
+            localPath: f.path,
+            summary: f.name.replace(/\.pdf$/i, ''),
+            context: 'Peça oficial extraída dos autos integrais do eproc TJRS via Certificado Digital A1.'
+          },
