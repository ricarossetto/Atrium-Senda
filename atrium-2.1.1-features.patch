+  const intimationId = `int-eproc-${d.cnj.replace(/\D/g, '')}-${d.startDate.replace(/\D/g, '')}`;
+  const existingInt = state.intimations.find(i => i.id === intimationId || (i.processNumber === d.cnj && i.date === d.startDate));
+  if (!existingInt) {
+    state.intimations.push({
