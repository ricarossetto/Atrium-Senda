+export async function downloadProcessWithA1({
+  cnj,
+  pfxPath,
+  passphrase,
+  totpSecret,
+  headed = false,
+  securityManager,
+  documentStorage: injectedDocStorage,
+  readStateEnvelope,
+  saveState
