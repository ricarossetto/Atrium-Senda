+
+console.log('\n[3.1/4] Ingerindo intimações pendentes do eproc...');
+let newIntimations = 0;
+for (const p of extracted.pending) {
+  const intId = `int-pendente-${p.cnj.replace(/\D/g, '')}-${(p.sentDate || '').replace(/\D/g, '')}`;
