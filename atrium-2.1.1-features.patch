+
+const __filename = fileURLToPath(import.meta.url);
+const ROOT = path.dirname(path.dirname(path.dirname(__filename)));
+const DATA_DIR = path.join(ROOT, 'data');
+const APP_STATE_FILE = path.join(DATA_DIR, 'app-state.json');
