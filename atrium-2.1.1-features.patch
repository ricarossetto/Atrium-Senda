+          name: f.name,
+          originalName: f.name,
+          mime: 'application/pdf',
+          size: fileBinary.length,
+          createdAt: nowIso,
+          updatedAt: nowIso,
+          documentDate: nowIso.slice(0, 10),
+          ownerType: 'process',
+          ownerId: procId,
+          documentType: docType,
